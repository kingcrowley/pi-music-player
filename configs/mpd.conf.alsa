# MPD Configuration for ALSA Audio Backend
# Generated by SystemDetector

music_directory    "/mnt/nas/music"
playlist_directory "/var/lib/mpd/playlists"
state_file         "/var/lib/mpd/state"
sticker_file       "/var/lib/mpd/sticker.sql"
log_file           "/var/log/mpd/mpd.log"
user               "player"
bind_to_address    "127.0.0.1"
port               "6600"

auto_update        "no"

database {
    plugin          "simple"
    path            "/var/lib/mpd/mpd.db"
}

# ALSA Audio Output - HDMI
audio_output {
    type        "alsa"
    name        "ALSA Default"
    device      "default"
    mixer_type  "software"
}

# Alternative: I2S DAC HAT (uncomment and comment out above if using DAC HAT)
# audio_output {
#     type        "alsa"
#     name        "DAC HAT"
#     device      "hw:CARD=<cardname>,DEV=0"
#     mixer_type  "software"
#     mixer_control "Master"
# }

auto_update        "no"

input {
    timeout      "10"
    timeout_action "stop"
}

<|end|>