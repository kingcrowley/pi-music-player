# MPD Configuration for PulseAudio Audio Backend
# Generated by SystemDetector
#
# Note: If the player user cannot access the PulseAudio session (e.g., running
# as a different user than the PulseAudio login), audio will not play. Ensure
# the player user is in the pulse-access group or $XDG_RUNTIME_DIR is set
# correctly for the player user.

music_directory    "/mnt/nas/music"
playlist_directory "/var/lib/mpd/playlists"
state_file         "/var/lib/mpd/state"
sticker_file       "/var/lib/mpd/sticker.sql"
log_file           "/var/log/mpd/mpd.log"
user               "player"
bind_to_address    "127.0.0.1"
port               "6600"

auto_update        "no"

database {
    plugin          "simple"
    path            "/var/lib/mpd/mpd.db"
}

# PulseAudio Audio Output
audio_output {
    type        "pulse"
    name        "PulseAudio Default"
}